# Local dev: copy to .env in the app directory. Never commit .env.
# Production: /etc/profet/profet-db-dash.env (loaded by profetdb.service).

# Generate once with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Public app URL including /profetDB path (no trailing slash).
# Prod: https://tools.tartaglialab.com/profetDB
# Dev:  http://localhost:8050/profetDB
PROFETDB_BASE_URL=http://localhost:8050/profetDB

# Days a download link / its data stays valid before deletion.
DOWNLOAD_TTL_DAYS=5

# Gmail app password for webservice@tartaglialab.com (result notification emails).
SMTP_PASSWORD=
